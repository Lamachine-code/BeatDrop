    "@twurple/auth": "^7.2.0",
    "@twurple/eventsub-ws": "^7.2.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.38.3",
    "fastify": "^5.2.0",
    "jose": "^5.9.6",
    "postgres": "^3.4.5",
    "socket.io": "^4.8.1",
    "tsx": "^4.19.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "drizzle-kit": "^0.30.1",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8"
  }
